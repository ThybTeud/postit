# Configuration Backend

# Port du serveur
PORT=3000

# URL de connexion PostgreSQL (production)
# Format: postgresql://username:password@hostname:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/postit

# URL de connexion PostgreSQL (test)
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/postit_test

# Origine CORS (URL du frontend déployé)
CORS_ORIGIN=http://localhost:5173

# Environnement (development, production, test)
NODE_ENV=development
